# Runtime mode
NETCHAT_RUNTIME=claude
NETCHAT_PERMISSION_MODE=bypassPermissions
NETCHAT_ALLOW_DANGEROUS=true

# Claude executable and working directory
CLAUDE_BINARY_PATH=C:\Users\your-name\.local\bin\claude.exe
CLAUDE_PROJECT_CWD=C:\path\to\netchat

# Local service ports
PORT=3001
DAEMON_PORT=4318
DAEMON_BASE_URL=http://127.0.0.1:4318
VITE_API_BASE_URL=http://127.0.0.1:3001
